# LLM provider — Anthropic direct.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults: Haiku 4.5 for fast/cheap, Sonnet 4.6 as
# fallback for hard JSON-parse failures and the chat block-builder.
# MODEL=claude-haiku-4-5
# MODEL_FALLBACK=claude-sonnet-4-6
# CARD_CUT_MODEL=claude-haiku-4-5
# CARD_CUT_FALLBACK_MODEL=claude-sonnet-4-6
# CHAT_MODEL_BLOCK=claude-sonnet-4-6

# Embeddings run locally via @xenova/transformers. No API key needed.
# Model downloads to node_modules on first use (~25 MB).
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# EMBED_DIM=384

# Server
PORT=3000
# Optional — defaults to server/data/library.db
DB_PATH=

# Free-tier monthly caps
FREE_CHAT_DAILY=10
FREE_CUTCARD_DAILY=5

# Google OAuth — create OAuth 2.0 Client ID (Web) in Google Cloud Console.
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: not needed for GIS ID-token flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Password-reset email (Gmail SMTP with app password works for free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password-16-chars
SMTP_FROM="Verba <you@gmail.com>"
PUBLIC_BASE_URL=http://localhost:3000

# Web fetch backend. When USE_WEBFETCH=true, scraper.js routes HTML fetches through
# Jina Reader (https://r.jina.ai). Zero local infra. JINA_API_KEY is optional but
# raises rate limits. Leave USE_WEBFETCH=false (default) to use legacy axios+cheerio.
USE_WEBFETCH=false
JINA_API_KEY=
